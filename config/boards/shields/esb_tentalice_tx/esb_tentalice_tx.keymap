/*
 * TentAlice keymap ported from zmk-config-tentalice
 * (config/tentalice.keymap).
 *
 * Simplifications for this ESB test config (external ZMK modules
 * used by the original are not in this workspace):
 * - Trackball processors: sensor_rotation (45 deg), pointer
 *   acceleration, scroll snap and mouse gesture are omitted.
 *   Kept (ZMK core): XY swap/invert, temp mouse layer, scroll
 *   mode on layers 1/2.
 * - The RGB layer/mod indicator hold-taps (rlt and rmt families)
 *   are replaced by plain &lt / &mt with the same parameters.
 * - &mouse_gesture (layer 4) is &trans; layer 5's &out / &bt
 *   entries are &trans (this build has no USB/BLE endpoints).
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/zmk/behaviors.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    quick-tap-ms = <180>;
    flavor = "hold-preferred";
};

&mt {
    quick-tap-ms = <180>;
    flavor = "hold-preferred";
};

/* Trackball: ball movement raises the mouse layer (core temp-layer
 * processor), same idea as the original. */
&zip_temp_layer {
    excluded-positions = <
        12 /* left Ctrl */
        24 /* left Shift */
        30 /* right B */
        31 /* N */
        32 /* M */
        33 /* , */
        37 /* left Alt */
    >;
    require-prior-idle-ms = <200>;
};

&mkp_input_listener {
    input-processors = <&zip_temp_layer 4 100000>;
};

/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)
            &zip_temp_layer 4 100000
        >;

        scroll_mode {
            layers = <1 2>;
            input-processors = <
                &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)
                &zip_xy_to_scroll_mapper
                &zip_scroll_scaler 1 10
            >;
        };
    };

    behaviors {
        td_CS: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <170>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            label = ",";
        };

        td_DC: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <170>;
            bindings = <&kp DOT>, <&jp_colon>;
            label = ".";
        };

        td_CME: tap_dance_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <170>;
            bindings = <&mt RCTRL MINUS>, <&jp_equal>;
            label = "/";
        };

        /* JP layout macros (same definitions as the original). */

        jp_dquote: jp_dquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_DQUOTE";
            bindings = <&kp AT>;
        };

        jp_amp: jp_amp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_AMP";
            bindings = <&kp CARET>;
        };

        jp_quote: jp_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_QUOTE";
            bindings = <&kp AMPERSAND>;
        };

        jp_equal: jp_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_EQUAL";
            bindings = <&kp UNDER>;
        };

        jp_caret: jp_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_CARET";
            bindings = <&kp EQUAL>;
        };

        jp_yen: jp_yen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_YEN";
            bindings = <&kp 0x89>;
        };

        jp_plus: jp_plus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_PLUS";
            bindings = <&kp COLON>;
        };

        jp_tilde: jp_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_TILDE";
            bindings = <&kp PLUS>;
        };

        jp_pipe: jp_pipe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_PIPE";
            bindings = <&kp LS(0x89)>;
        };

        jp_at: jp_at {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_AT";
            bindings = <&kp LEFT_BRACKET>;
        };

        jp_colon: jp_colon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_COLON";
            bindings = <&kp SINGLE_QUOTE>;
        };

        jp_aster: jp_aster {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_ASTER";
            bindings = <&kp DOUBLE_QUOTES>;
        };

        jp_baqt: jp_baqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_BAQT";
            bindings = <&kp LEFT_BRACE>;
        };

        jp_under: jp_under {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_UNDER";
            bindings = <&kp LS(0x87)>;
        };

        jp_lbrkt: jp_lbrkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_LBRACKET";
            bindings = <&kp RIGHT_BRACKET>;
        };

        jp_rbrkt: jp_rbrkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_RBRACKET";
            bindings = <&kp BACKSLASH>;
        };

        jp_lpar: jp_lpar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_LPAREN";
            bindings = <&kp ASTERISK>;
        };

        jp_rpar: jp_rpar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_RPAREN";
            bindings = <&kp LEFT_PARENTHESIS>;
        };

        jp_lbrace: jp_lbrace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_LBRACE";
            bindings = <&kp RIGHT_BRACE>;
        };

        jp_rbrace: jp_rbrace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_RBRACE";
            bindings = <&kp PIPE>;
        };

        jp_kana: jp_kana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_KANA";
            bindings = <&kp LANGUAGE_1>;
        };

        jp_eisu: jp_eisu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_EISU";
            bindings = <&kp LANGUAGE_2>;
        };

        jp_hanzen: jp_hanzen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "JP_HANZEN";
            bindings = <&kp GRAVE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
                &kp ESC            &kp Q  &kp W  &kp E  &kp R  &kp T            &kp Y  &kp U  &kp I  &kp O   &kp P    &kp BSPC
                &mt LCTRL TAB      &kp A  &kp S  &kp D  &kp F  &kp G            &kp H  &kp J  &kp K  &kp L   &td_CME  &mt RCTRL LS(RET)
                &mt LSHFT CAPSLOCK &kp Z  &kp X  &kp C  &kp V  &kp B            &kp B  &kp N  &kp M  &td_CS  &td_DC   &mt RSHFT SLASH
                &lt 3 LG(TAB)      &mt LALT CAPSLOCK  &lt 1 SPACE  &lt 2 RET  &mt RGUI RS(K_APP)  &lt 4 DEL
            >;
        };

        layer_1 {
            bindings = <
                &bootloader &kp F1    &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &kp F7  &kp F8   &kp F9     &kp F10              &trans
                &trans      &kp N1    &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7  &kp N8   &kp N9     &kp N0               &trans
                &trans      &jp_plus  &kp MINUS  &jp_aster  &kp SLASH  &jp_under  &jp_equal  &jp_at  &jp_yen  &jp_colon  &kp INTERNATIONAL_1  &trans
                &lt 5 SPACE &trans    &trans     &trans     &trans     &trans
            >;
        };

        layer_2 {
            bindings = <
                &trans  &kp EXCL   &jp_dquote  &kp HASH  &kp DLLR   &kp PRCNT            &jp_amp     &kp PG_UP  &kp UP    &kp PG_DN  &trans    &kp DEL
                &trans  &jp_amp    &jp_quote   &jp_lpar  &jp_lbrkt  &jp_lbrace           &kp HOME    &kp LEFT   &kp DOWN  &kp RIGHT  &kp BSPC  &trans
                &trans  &jp_caret  &jp_baqt    &jp_rpar  &jp_rbrkt  &jp_rbrace           &kp LA(UP)  &kp END    &trans    &trans     &trans    &trans
                &trans  &trans     &trans      &trans    &trans     &lt 5 SPACE
            >;
        };

        layer_3 {
            bindings = <
                &trans  &trans     &trans               &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans     &trans               &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp LC(Z)  &kp LC(X)            &kp LC(C)  &kp LC(V)  &kp LC(Y)  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans     &lt 5 SPACE          &trans     &trans     &trans
            >;
        };

        layer_4 {
            bindings = <
                &trans  &trans  &trans  &trans               &trans  &trans  &trans     &trans     &trans  &trans          &trans  &rgb_ug RGB_EFR
                &trans  &trans  &trans  &trans               &trans  &trans  &trans     &trans     &trans  &trans          &trans  &rgb_ug RGB_EFF
                &trans  &trans  &trans  &trans               &trans  &trans  &mkp LCLK  &mkp RCLK  &mo 1   &trans          &trans  &trans
                &trans  &trans  &trans  &lt 5 SPACE          &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &bootloader   &trans        &trans        &bootloader   &trans
            >;
        };
    };
};
