/*
 * ESB TX on the real TentAlice PCB (unibody, XIAO nRF52840,
 * PMW3610 trackball).
 *
 * Hardware definition copied from zmk-config-tentalice
 * (boards/shields/tentalice): charlieplex kscan on xiao_d
 * 2/3/5/4/1/0/9 with wake interrupt on P0.09 (NFC pin, needs
 * nfct-pins-as-gpios), trackball on spi0 (SCK P1.13, MOSI/MISO
 * P1.15, CS xiao_d 7, motion xiao_d 6), WS2812 x4 on spi3
 * MOSI P0.10.
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = <&kscan0>;
        zmk,physical-layout = <&tentalice_default_layout>;
        zmk,underglow = &led_strip;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-charlieplex";
        wakeup-source;
        interrupt-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        gpios
            = <&xiao_d 2 GPIO_ACTIVE_HIGH>
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>
            , <&xiao_d 5 GPIO_ACTIVE_HIGH>
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>
            , <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 0 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>
            ;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <7>;
        columns = <7>;
        map = <
            RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)   RC(1,0) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)
            RC(2,0) RC(2,1) RC(2,3) RC(2,4) RC(2,5) RC(2,6)   RC(3,0) RC(3,1) RC(3,2) RC(3,4) RC(3,5) RC(3,6)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,5) RC(4,6)   RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,6)
            RC(6,0)                 RC(6,1) RC(6,2)                   RC(6,3) RC(6,4)                 RC(6,5)
        >;
    };

    tentalice_default_layout: tentalice_default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Tentalice";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100   40   45  (-200)   160    85>
            , <&key_physical_attrs 100 100  140   45  (-100)     0  (-5)>
            , <&key_physical_attrs 100 100  212   45     700   265   375>
            , <&key_physical_attrs 100 100  310   45     800   265   360>
            , <&key_physical_attrs 100 100  410   45     900   275   335>
            , <&key_physical_attrs 100 100  510   45    1000   295   315>

            , <&key_physical_attrs 100 100  800   45 (-1000)  1115   335>
            , <&key_physical_attrs 100 100  900   45  (-900)  1135   355>
            , <&key_physical_attrs 100 100 1000   45  (-800)  1150   380>
            , <&key_physical_attrs 100 100 1100   45  (-700)  1150   410>
            , <&key_physical_attrs 100 100 1165   20     100   130   195>
            , <&key_physical_attrs 100 100 1270    0     200   140    15>

            , <&key_physical_attrs 125 100   25  145  (-200)   160    90>
            , <&key_physical_attrs 100 100  155  145  (-100)    65   175>
            , <&key_physical_attrs 100 100  240  145     700   260   350>
            , <&key_physical_attrs 100 100  340  145     800   260   335>
            , <&key_physical_attrs 100 100  440  145     900   270   325>
            , <&key_physical_attrs 100 100  540  145    1000   300   315>

            , <&key_physical_attrs 100 100  825  145 (-1000)  1115   335>
            , <&key_physical_attrs 100 100  925  145  (-900)  1135   345>
            , <&key_physical_attrs 100 100 1025  145  (-800)  1150   360>
            , <&key_physical_attrs 100 100 1125  145  (-700)  1150   375>
            , <&key_physical_attrs 100 100 1210  125     100   370    45>
            , <&key_physical_attrs 100 100 1310  100     200    90   120>

            , <&key_physical_attrs 175 100    0  245  (-200)   160   195>
            , <&key_physical_attrs 100 100  175  245  (-100)     0    85>
            , <&key_physical_attrs 100 100  275  245     700   275   365>
            , <&key_physical_attrs 100 100  373  245     800   275   375>
            , <&key_physical_attrs 100 100  473  245     900   285   370>
            , <&key_physical_attrs 100 100  573  245    1000   310   365>

            , <&key_physical_attrs 100 100  775  245 (-1000)  1105   335>
            , <&key_physical_attrs 100 100  875  245 (-1000)  1105   335>
            , <&key_physical_attrs 100 100  975  245  (-900)  1120   335>
            , <&key_physical_attrs 100 100 1075  245  (-800)  1130   335>
            , <&key_physical_attrs 100 100 1190  225     100   300 (-600)>
            , <&key_physical_attrs 150 100 1285  200     200    50     0>

            , <&key_physical_attrs 125 100   30  345  (-200)   165  (-5)>
            , <&key_physical_attrs 150 100  265  350     700   200   600>
            , <&key_physical_attrs 200 100  413  350     900   250   575>

            , <&key_physical_attrs 175 100  825  350 (-1000)  1110   335>
            , <&key_physical_attrs 150 100 1000  350  (-800)  1120   310>
            , <&key_physical_attrs 125 100 1260  300     200    50   155>
            ;
    };
};

&uicr {
    nfct-pins-as-gpios;
};

&xiao_serial { status = "disabled"; };

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };

    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 15)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 15)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <4>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};

#include <zephyr/dt-bindings/input/input-event-codes.h>

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&xiao_d 7 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        motion-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        res-cpi = <800>;
        zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;
    };
};
