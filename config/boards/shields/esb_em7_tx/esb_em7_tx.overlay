/*
 * EM7 XIAO PCB: Kensington Expert Mouse replacement board with a
 * XIAO nRF52840 Plus, PMW3610 trackball, 4 buttons, a
 * photointerrupter scroll ring and a MOSFET-gated LED.
 *
 * Pin assignment (provided by the board's collaborator 2026-11-18;
 * the schematic itself was not read):
 *   PMW3610:  SCK=D18 (P1.05), SDIO=D8 (P1.13), CS=D9 (P1.14),
 *             MOTION=D10 (P1.15)
 *   Buttons:  SW1=D7 (P1.12), SW2=D12 (P0.19), SW3=D17 (P1.03),
 *             SW4=D11 (P0.15)
 *   Ring:     PT5529B photointerrupter, A=D0 (P0.02), B=D1 (P0.03)
 *   LED:      D13 (P1.01) drives the gate (pin 1) of a DMG2302U
 *             N-channel MOSFET that switches the LED, active high.
 *   No battery: USB powered.
 *
 * The Plus-only pins (D11/D12/D13/D17/D18) have no xiao_d nexus
 * entries, so they are referenced as raw &gpio0/&gpio1 pins. None of
 * them collide with the board's QSPI flash pins (P0.20..P0.25).
 *
 * Unverified assumptions for bring-up (check on hardware):
 * - Buttons are active-low to GND (internal pull-up used here).
 * - Ring phototransistor outputs are open-collector style
 *   (internal pull-up, active high decode like the gpio-qdec
 *   binding example). Scroll direction may need A/B swapped.
 * - SW1..SW4 order vs. the physical button positions on the EM7
 *   shell is unconfirmed; keymap defaults are SW1=LCLK, SW2=RCLK,
 *   SW3=MCLK, SW4=MB4.
 * - PMW3610 orientation/rotation is unconfirmed; the listener in
 *   the keymap applies no transform yet.
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/input/input-event-codes.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = <&kscan0>;
        zmk,physical-layout = <&em7_layout>;
        zmk,ext-power = <&ext_power>;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&gpio1 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>  /* SW1 = D7  */
            , <&gpio0 19 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>  /* SW2 = D12 */
            , <&gpio1  3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>  /* SW3 = D17 */
            , <&gpio0 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>  /* SW4 = D11 */
            ;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
        >;
    };

    em7_layout: em7_layout {
        compatible = "zmk,physical-layout";
        display-name = "EM7";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w   h    x    y   rot  rx  ry
            = <&key_physical_attrs 100 100    0    0     0   0   0>
            , <&key_physical_attrs 100 100  100    0     0   0   0>
            , <&key_physical_attrs 100 100  200    0     0   0   0>
            , <&key_physical_attrs 100 100  300    0     0   0   0>
            ;
    };

    /* D13 -> DMG2302U gate: on while the device is awake, so the
     * LED behind the MOSFET is powered. Toggle with &ext_power. */
    ext_power: ext_power {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
    };

    /* Scroll ring: PT5529B photointerrupter quadrature -> wheel.
     * One full A/B cycle (4 transitions) per slot = 1 wheel step. */
    ring_qdec: ring_qdec {
        compatible = "gpio-qdec";
        gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>,
                <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
        steps-per-period = <4>;
        zephyr,axis = <INPUT_REL_WHEEL>;
        sample-time-us = <2000>;
        idle-timeout-ms = <200>;
    };
};

&xiao_serial { status = "disabled"; };

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>,
                    <NRF_PSEL(SPIM_MISO, 1, 13)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>,
                    <NRF_PSEL(SPIM_MISO, 1, 13)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        motion-gpios = <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        res-cpi = <800>;
        zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;
    };
};
