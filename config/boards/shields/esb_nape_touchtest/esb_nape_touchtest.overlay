#include <zephyr/dt-bindings/gpio/gpio.h>

/*
 * Nape Deck TOUCH TEST variant — layer on top of esb_nape_disptest:
 *
 *   west build ... -DSHIELD="esb_nape_rx;esb_nape_disptest;esb_nape_touchtest"
 *
 * v1 of this variant moved the CST816S's hardware I2C0 to the guessed
 * Scanner harness pins (SDA=P1.02, SCL=P1.04) and scanned the bus:
 * 0 devices. The chip also never answered on the production pins
 * (SDA=P1.00, SCL=P1.10) in the esb_nape_rx build. One suspect that
 * v1 left in place: the disptest layer "parks" the dummy PAW3222 SPI
 * on D1/D2/D0 (SCK=P0.03, MOSI/SDIO=P0.28, CS=P0.02) and the dummy
 * kscan inputs on P1.02/P1.03/P1.04. If the Scanner harness lands a
 * touch line on D0/D1/D2 — the RST line above all — the parked SPI
 * pinctrl keeps those pins configured as peripheral lines and can
 * hold the touch chip in reset, which would explain why it answers
 * on no I2C pin pair at all.
 *
 * v2 therefore removes every parking side effect instead of moving
 * it around:
 *
 *  - The PAW3222 sensor node AND its SPI1 bus are disabled outright,
 *    so the parked pinctrl is never applied and nothing claims
 *    D0/D1/D2. This is now known to be the crux, not just hygiene:
 *    the Prospector schematic confirms TP_RST lands on D1 = P0.03 —
 *    the parked dummy SPI's SCK pin, idle-low, i.e. the touch chip
 *    was held in reset by it. src/touch_test.c drives P0.03 HIGH
 *    before scanning to release TP_RST explicitly. (The
 *    zmk,input-listener instance that references the sensor
 *    compiles out when its device is not "okay", so disabling the
 *    sensor is safe.)
 *  - The dummy kscan cannot be disabled: zmk's physical_layouts.c
 *    takes DEVICE_DT_GET(DT_CHOSEN(zmk_kscan)) unconditionally and
 *    a disabled node has no device struct (build error). Instead
 *    all three of its inputs are parked on P1.03 alone — the one
 *    disptest parking pin that is not an I2C candidate and not a
 *    D-pin — so it claims nothing the touch wiring could use.
 *  - The v1 I2C0 pinctrl move is reverted (the blocks are gone):
 *    hardware I2C0 sits on the production pins again and the CST816S
 *    driver still fails init there — expected and harmless in this
 *    variant. Finding the chip is src/touch_test.c's job now: it
 *    bit-bangs an address scan over the candidate (SDA, SCL) GPIO
 *    pairs after first releasing D0/D1/D2 as pulled-up inputs.
 *
 * Nothing else changes: display and backlight stay exactly as the
 * disptest layer defines them.
 */

&paw3222 {
	status = "disabled";
};

&spi1 {
	status = "disabled";
};

&kscan {
	input-gpios =
		<&gpio1 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
		<&gpio1 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
		<&gpio1 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};
